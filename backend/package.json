{
  "name": "ecorecicla-backend",
  "version": "1.0.0",
  "description": "API REST de EcoRecicla (Node.js + Express + MySQL 8)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node ../database/seed.js",
    "test": "jest --coverage --runInBand",
    "test:unit": "jest tests/validaciones.test.js tests/impacto.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/helpers/preparar-bd.js",
    "setupFiles": [
      "./tests/helpers/entorno.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/helpers/cerrar-pool.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "app.js"
    ]
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
