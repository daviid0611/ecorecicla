    {
      "name": "RF2 - Login administrador (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const datos = pm.response.json();",
              "if (datos.token) { pm.collectionVariables.set('token', datos.token); }",
              "pm.test('Responde 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
